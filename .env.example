# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional overrides for firebase-applet-config.json)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"

# Primary Production Domain & Master Admin Email
NEXT_PUBLIC_SITE_URL="https://ddnprimenews.com"
NEXT_PUBLIC_FIREBASE_ADMIN_EMAIL="ddnprimenews@gmail.com"

# SMTP Email Automation Configuration (for OTP and Welcome Letters)
# Sender Email Address: ddnprimenews@gmail.com
# For Gmail: Use 16-character Google App Password (from Google Account > Security > 2-Step Verification > App Passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="ddnprimenews@gmail.com"
SMTP_PASS="your_16_char_gmail_app_password"
SMTP_FROM="DDN Prime News <ddnprimenews@gmail.com>"
