rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Runtime Admin Check: Master email ddnprimenews@gmail.com or admin document
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'ddnprimenews@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isEditor() {
      return isAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor']
      );
    }

    // Validation for Article
    function isValidArticle(data) {
      return data.keys().hasAll(['title', 'summary', 'category', 'status'])
        && data.title is string && data.title.size() <= 500
        && data.summary is string && data.summary.size() <= 2000
        && data.status in ['published', 'draft'];
    }

    // Validation for Reporter
    function isValidReporter(data) {
      return data.keys().hasAll(['fullName', 'mobile', 'district'])
        && data.fullName is string && data.fullName.size() <= 120
        && data.mobile is string && data.mobile.size() <= 20
        && data.district is string && data.district.size() <= 100;
    }

    // Connection health check
    match /test/{docId} {
      allow get: if true;
    }

    // Articles Collection
    match /articles/{articleId} {
      // Anyone can read published articles; editors can read drafts
      allow get: if isValidId(articleId) && (resource == null || existing().status == 'published' || isEditor());
      allow list: if resource.data.status == 'published' || isEditor();
      
      allow create: if isValidId(articleId) && isEditor() && isValidArticle(incoming());
      allow update: if isValidId(articleId) && isEditor() && isValidArticle(incoming());
      allow delete: if isValidId(articleId) && isAdmin();
    }

    // Reporter Applications: public submissions start as 'pending' only
    match /reporters/{reporterId} {
      allow create: if isValidId(reporterId) && isValidReporter(incoming()) && incoming().status == 'pending';
      allow get: if isValidId(reporterId) && (isEditor() || (isSignedIn() && existing().mobile == request.auth.token.phone_number));
      allow list: if isEditor();
      allow update, delete: if isValidId(reporterId) && isEditor();
    }

    // Breaking News Ticker Feed
    match /breaking_news/{breakingId} {
      allow read: if true;
      allow create, update, delete: if isValidId(breakingId) && isEditor();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Profiles with RBAC
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().role == 'reader';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
